{
  "name": "image-picker",
  "type": "ui",
  "dependencies": [],
  "registryDependencies": [],
  "files": [
    {
      "name": "ImageDisplay.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport { computed, ref, watch } from 'vue'\nimport { cn } from '../../../lib/utils'\n\nconst props = withDefaults(\n  defineProps<{\n    src?: string\n    alt?: string\n    size?: 'small' | 'large-4:3' | 'large-1:1'\n    status?: 'filled' | 'filled-more' | 'empty' | 'broken'\n    count?: number\n    class?: HTMLAttributes['class']\n    imageClass?: HTMLAttributes['class']\n  }>(),\n  {\n    size: 'small',\n    count: 1,\n  },\n)\n\nconst emit = defineEmits<{\n  (e: 'error', event: Event): void\n}>()\n\nconst isImageError = ref(false)\n\nwatch(\n  () => props.src,\n  () => {\n    isImageError.value = false\n  },\n)\n\nconst currentStatus = computed(() => {\n  if (props.status) return props.status\n  if (isImageError.value) return 'broken'\n  if (!props.src) return 'empty'\n  return 'filled'\n})\n\nconst sizeClasses = computed(() => {\n  switch (props.size) {\n    case 'large-4:3':\n      return 'h-[120px] w-[180px] rounded-[12px]'\n    case 'large-1:1':\n      return 'size-[120px] rounded-[12px]'\n    case 'small':\n    default:\n      return 'size-[80px] rounded-[8px]'\n  }\n})\n\nconst handleImageError = (e: Event) => {\n  isImageError.value = true\n  emit('error', e)\n}\n</script>\n\n<template>\n  <div\n    :class=\"\n      cn(\n        'relative inline-flex shrink-0 items-center justify-center overflow-hidden border border-black-200 bg-white align-middle font-sans transition-all',\n        sizeClasses,\n        props.class,\n      )\n    \"\n  >\n    <!-- FILLED STATE -->\n    <template v-if=\"currentStatus === 'filled' && src\">\n      <img\n        :src=\"src\"\n        :alt=\"alt ?? ''\"\n        :class=\"cn('h-full w-full object-cover', imageClass)\"\n        @error=\"handleImageError\"\n      >\n    </template>\n\n    <!-- FILLED MORE STATE -->\n    <template v-else-if=\"currentStatus === 'filled-more' && src\">\n      <img\n        :src=\"src\"\n        :alt=\"alt ?? ''\"\n        :class=\"cn('h-full w-full object-cover', imageClass)\"\n        @error=\"handleImageError\"\n      >\n      <!-- Dark overlay with +1 / +count badge -->\n      <div\n        class=\"absolute inset-0 flex items-center justify-center bg-black-900/50 backdrop-blur-[0.5px]\"\n      >\n        <span class=\"font-extrabold text-[14px] text-white tracking-wide\">\n          {{ count }}+\n        </span>\n      </div>\n    </template>\n\n    <!-- EMPTY STATE ILLUSTRATION -->\n    <template v-else-if=\"currentStatus === 'empty'\">\n      <div class=\"flex size-full flex-col items-center justify-center bg-white p-2 text-black-400\">\n        <svg class=\"size-9\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path\n            d=\"M32 10H8C6.89543 10 6 10.8954 6 12V28C6 29.1046 6.89543 30 8 30H32C33.1046 30 34 29.1046 34 28V12C34 10.8954 33.1046 10 32 10Z\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n          <circle cx=\"14\" cy=\"16\" r=\"3\" stroke=\"currentColor\" stroke-width=\"2\" />\n          <path\n            d=\"M34 25L26 18L12 30\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n        </svg>\n      </div>\n    </template>\n\n    <!-- BROKEN STATE ILLUSTRATION -->\n    <template v-else-if=\"currentStatus === 'broken'\">\n      <div class=\"flex size-full flex-col items-center justify-center bg-white p-2 text-black-400\">\n        <svg class=\"size-9\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path\n            d=\"M32 10H8C6.89543 10 6 10.8954 6 12V28C6 29.1046 6.89543 30 8 30H32C33.1046 30 34 29.1046 34 28V12C34 10.8954 33.1046 10 32 10Z\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n          <path\n            d=\"M12 28L18 20L22 24L26 18L34 28\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n          <!-- Broken / Slash overlay line -->\n          <line\n            x1=\"8\"\n            y1=\"32\"\n            x2=\"32\"\n            y2=\"8\"\n            stroke=\"#E53E3E\"\n            stroke-width=\"2.5\"\n            stroke-linecap=\"round\"\n          />\n        </svg>\n      </div>\n    </template>\n  </div>\n</template>\n"
    },
    {
      "name": "ImagePicker.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport { computed, onUnmounted, ref, watch } from 'vue'\nimport { cn } from '../../../lib/utils'\n\nconst props = withDefaults(\n  defineProps<{\n    modelValue?: string | File | null\n    size?: 'small' | 'large'\n    aspectRatio?: '4:3' | '1:1'\n    accept?: string\n    disabled?: boolean\n    maxSize?: number // Max size in bytes\n    class?: HTMLAttributes['class']\n    imageClass?: HTMLAttributes['class']\n  }>(),\n  {\n    size: 'large',\n    aspectRatio: '4:3',\n    accept: 'image/*',\n    disabled: false,\n  },\n)\n\nconst emit = defineEmits<{\n  (e: 'update:modelValue', value: string | File | null): void\n  (e: 'change', value: File | string | null): void\n  (e: 'remove'): void\n  (e: 'error', message: string): void\n}>()\n\nconst fileInputRef = ref<HTMLInputElement | null>(null)\nconst isDragging = ref(false)\nconst objectUrl = ref<string | null>(null)\n\n// Cleanup object URL when file changes or component unmounts\nconst cleanupObjectUrl = () => {\n  if (objectUrl.value) {\n    URL.revokeObjectURL(objectUrl.value)\n    objectUrl.value = null\n  }\n}\n\nwatch(\n  () => props.modelValue,\n  (newVal) => {\n    cleanupObjectUrl()\n    if (newVal instanceof File) {\n      objectUrl.value = URL.createObjectURL(newVal)\n    }\n  },\n  { immediate: true },\n)\n\nonUnmounted(() => {\n  cleanupObjectUrl()\n})\n\nconst previewUrl = computed(() => {\n  if (typeof props.modelValue === 'string') {\n    return props.modelValue\n  }\n  if (props.modelValue instanceof File) {\n    return objectUrl.value\n  }\n  return null\n})\n\nconst isFilled = computed(() => !!previewUrl.value)\n\nconst triggerFileInput = () => {\n  if (props.disabled) return\n  fileInputRef.value?.click()\n}\n\nconst handleFileSelect = (file: File | null) => {\n  if (!file) return\n\n  if (props.accept && !file.type.match(props.accept.replace(/\\*/g, '.*'))) {\n    emit('error', 'Tipe file tidak didukung.')\n    return\n  }\n\n  if (props.maxSize && file.size > props.maxSize) {\n    const maxMb = (props.maxSize / (1024 * 1024)).toFixed(1)\n    emit('error', `Ukuran file melebihi batas maksimum ${maxMb}MB.`)\n    return\n  }\n\n  emit('update:modelValue', file)\n  emit('change', file)\n}\n\nconst onFileChange = (event: Event) => {\n  const target = event.target as HTMLInputElement\n  const file = target.files?.[0] || null\n  handleFileSelect(file)\n}\n\nconst onDrop = (event: DragEvent) => {\n  if (props.disabled) return\n  isDragging.value = false\n  const file = event.dataTransfer?.files?.[0] || null\n  handleFileSelect(file)\n}\n\nconst handleRemove = (event: Event) => {\n  event.stopPropagation()\n  if (props.disabled) return\n  if (fileInputRef.value) {\n    fileInputRef.value.value = ''\n  }\n  emit('update:modelValue', null)\n  emit('change', null)\n  emit('remove')\n}\n</script>\n\n<template>\n  <div\n    :class=\"\n      cn(\n        'relative bg-white font-sans transition-all',\n        size === 'small' ? 'size-[80px]' : 'h-[160px] w-[328px]',\n        disabled && 'opacity-60 cursor-not-allowed',\n        props.class,\n      )\n    \"\n  >\n    <!-- Hidden native file input -->\n    <input\n      ref=\"fileInputRef\"\n      type=\"file\"\n      :accept=\"accept\"\n      :disabled=\"disabled\"\n      class=\"hidden\"\n      @change=\"onFileChange\"\n    >\n\n    <!-- SMALL SIZE -->\n    <template v-if=\"size === 'small'\">\n      <!-- Small Empty Dropzone -->\n      <div\n        v-if=\"!isFilled\"\n        :class=\"\n          cn(\n            'group relative flex size-full cursor-pointer flex-col items-center justify-center rounded-[6px] border border-dashed border-black-300 bg-white transition-colors hover:border-lime-500 hover:bg-lime-50/30',\n            isDragging && 'border-lime-500 bg-lime-50/50',\n            disabled && 'pointer-events-none',\n          )\n        \"\n        @click=\"triggerFileInput\"\n        @dragover.prevent=\"isDragging = true\"\n        @dragleave.prevent=\"isDragging = false\"\n        @drop.prevent=\"onDrop\"\n      >\n        <!-- Icon Image Add -->\n        <svg\n          class=\"size-10 text-black-400 transition-colors group-hover:text-lime-600\"\n          viewBox=\"0 0 48 48\"\n          fill=\"none\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n        >\n          <path\n            d=\"M38 12H10C8.89543 12 8 12.8954 8 14V34C8 35.1046 8.89543 36 10 36H38C39.1046 36 40 35.1046 40 34V14C40 12.8954 39.1046 12 38 12Z\"\n            stroke=\"currentColor\"\n            stroke-width=\"2.5\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n          <path\n            d=\"M17 22C18.6569 22 20 20.6569 20 19C20 17.3431 18.6569 16 17 16C15.3431 16 14 17.3431 14 19C14 20.6569 15.3431 22 17 22Z\"\n            stroke=\"currentColor\"\n            stroke-width=\"2.5\"\n          />\n          <path\n            d=\"M40 30L31.5 22.5L16 36\"\n            stroke=\"currentColor\"\n            stroke-width=\"2.5\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n          <circle cx=\"34\" cy=\"18\" r=\"6\" fill=\"white\" />\n          <path\n            d=\"M34 15V21M31 18H37\"\n            stroke=\"currentColor\"\n            stroke-width=\"2.5\"\n            stroke-linecap=\"round\"\n          />\n        </svg>\n      </div>\n\n      <!-- Small Filled Preview -->\n      <div\n        v-else\n        class=\"group relative size-full overflow-hidden rounded-[8px] border border-black-200 bg-black-100\"\n      >\n        <img\n          :src=\"previewUrl!\"\n          alt=\"Preview\"\n          :class=\"cn('h-full w-full object-cover', imageClass)\"\n        >\n        <!-- Remove Button -->\n        <button\n          type=\"button\"\n          aria-label=\"Hapus gambar\"\n          class=\"absolute top-1 right-1 flex size-5 items-center justify-center rounded-full bg-black-800/80 text-white transition-opacity hover:bg-black-900 focus-visible:outline-none\"\n          @click=\"handleRemove\"\n        >\n          <svg class=\"size-3\" viewBox=\"0 0 12 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path\n              d=\"M9 3L3 9M3 3L9 9\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.5\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </button>\n      </div>\n    </template>\n\n    <!-- LARGE SIZE -->\n    <template v-else>\n      <!-- Container Box -->\n      <div\n        :class=\"\n          cn(\n            'relative flex size-full items-center justify-center rounded-[6px] border border-dashed border-black-300 bg-white p-3 transition-colors',\n            !isFilled && 'cursor-pointer hover:border-lime-500 hover:bg-lime-50/30',\n            isDragging && 'border-lime-500 bg-lime-50/50',\n          )\n        \"\n        @click=\"!isFilled && triggerFileInput()\"\n        @dragover.prevent=\"!isFilled && (isDragging = true)\"\n        @dragleave.prevent=\"!isFilled && (isDragging = false)\"\n        @drop.prevent=\"!isFilled && onDrop($event)\"\n      >\n        <!-- Large Empty Dropzone Icon -->\n        <div v-if=\"!isFilled\" class=\"flex flex-col items-center justify-center gap-2\">\n          <!-- Icon ID Card / Image Add Large -->\n          <svg\n            class=\"size-16 text-black-400 transition-colors group-hover:text-lime-600\"\n            viewBox=\"0 0 64 64\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <rect\n              x=\"10\"\n              y=\"14\"\n              width=\"44\"\n              height=\"36\"\n              rx=\"6\"\n              stroke=\"currentColor\"\n              stroke-width=\"3\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n            <circle cx=\"25\" cy=\"27\" r=\"5\" stroke=\"currentColor\" stroke-width=\"3\" />\n            <path\n              d=\"M16 43C16 37.4772 20.4772 33 26 33C31.5228 33 36 37.4772 36 43\"\n              stroke=\"currentColor\"\n              stroke-width=\"3\"\n              stroke-linecap=\"round\"\n            />\n            <circle cx=\"44\" cy=\"26\" r=\"8\" fill=\"white\" />\n            <circle cx=\"44\" cy=\"26\" r=\"7\" stroke=\"currentColor\" stroke-width=\"2.5\" />\n            <path\n              d=\"M44 22V30M40 26H48\"\n              stroke=\"currentColor\"\n              stroke-width=\"2.5\"\n              stroke-linecap=\"round\"\n            />\n          </svg>\n        </div>\n\n        <!-- Large Filled Preview Card -->\n        <div\n          v-else\n          :class=\"\n            cn(\n              'relative flex items-center justify-center rounded-[12px] border border-black-200 bg-black-100',\n              aspectRatio === '1:1' ? 'size-[120px]' : 'h-[120px] w-[180px]',\n            )\n          \"\n        >\n          <img\n            :src=\"previewUrl!\"\n            alt=\"Preview\"\n            :class=\"cn('h-full w-full rounded-[12px] object-cover', imageClass)\"\n          >\n\n          <!-- Remove Button Badge (Top Right of Preview Card) -->\n          <button\n            type=\"button\"\n            aria-label=\"Hapus gambar\"\n            class=\"absolute -top-2 -right-2 flex size-6 items-center justify-center rounded-full bg-black-800 text-white shadow-xs transition-transform hover:scale-110 hover:bg-black-900 focus-visible:outline-none\"\n            @click=\"handleRemove\"\n          >\n            <svg class=\"size-3.5\" viewBox=\"0 0 12 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path\n                d=\"M9 3L3 9M3 3L9 9\"\n                stroke=\"currentColor\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </svg>\n          </button>\n        </div>\n      </div>\n    </template>\n  </div>\n</template>\n"
    },
    {
      "name": "index.ts",
      "content": "export { default as ImageDisplay } from './ImageDisplay.vue'\nexport { default as ImagePicker } from './ImagePicker.vue'\n"
    }
  ]
}